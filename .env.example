# Configuration Flask
FLASK_SECRET_KEY=replace-with-a-long-random-value

# Configuration actuelle Groq
# Conservée temporairement pendant la migration
GROQ_API_KEY=

# Future configuration Albert API
ALBERT_API_KEY=
ALBERT_BASE_URL=
ALBERT_MODEL=

# Configuration de l'application
APP_ENV=development
LOG_LEVEL=INFO

# Fournisseur actif : groq ou albert
LLM_PROVIDER=groq

# Reconnaissance vocale locale, désactivée sur Render
ENABLE_VOSK=false
